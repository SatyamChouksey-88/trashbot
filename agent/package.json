{
  "name": "trashbot-agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:bundle",
    "build:tsc": "tsc -p .",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=esm --banner:js=\"#!/usr/bin/env node\"",
    "test": "vitest run",
    "mock": "tsx mock-robot/server.ts",
    "start": "node dist/index.js",
    "pack": "npm run build:bundle && npx @anthropic-ai/mcpb pack && node scripts/rename-mcpb.mjs",
    "verify:mcpb": "node scripts/verify-mcpb.mjs",
    "eval": "tsx evals/run_api_eval.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
